<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Sub-step 2.3 — adds min/max discount percentage columns to product.
        Default 0 means "no discount allowed" until configured by the back-office.
    -->
    <changeSet id="20260508140000-1" author="fedi">
        <addColumn tableName="product">
            <column name="min_discount_pct" type="decimal(21,2)" defaultValueNumeric="0">
                <constraints nullable="true" />
            </column>
            <column name="max_discount_pct" type="decimal(21,2)" defaultValueNumeric="0">
                <constraints nullable="true" />
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>