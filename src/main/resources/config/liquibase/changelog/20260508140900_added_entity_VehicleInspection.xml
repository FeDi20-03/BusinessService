<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Sub-step 2.13 — VehicleInspection. -->
    <changeSet id="20260508140900-1" author="fedi">
        <createTable tableName="vehicle_inspection">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="bigint"><constraints nullable="false"/></column>
            <column name="commercial_login" type="varchar(100)"><constraints nullable="false"/></column>
            <column name="chef_parc_login" type="varchar(100)"><constraints nullable="false"/></column>
            <column name="inspection_date" type="date"><constraints nullable="false"/></column>
            <column name="vehicle_state" type="varchar(50)"><constraints nullable="false"/></column>
            <column name="note" type="integer"><constraints nullable="false"/></column>
            <column name="needs_repair" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="comments" type="varchar(2000)"><constraints nullable="true"/></column>
        </createTable>
    </changeSet>

</databaseChangeLog>
