<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Sub-step 2.3 — adds applied_discount_pct to order_line.
        Captures the actual discount applied to each line; validated by
        DiscountRangeValidator against the product's min/max at submit time.
    -->
    <changeSet id="20260508140100-1" author="fedi">
        <addColumn tableName="order_line">
            <column name="applied_discount_pct" type="decimal(21,2)">
                <constraints nullable="true" />
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>