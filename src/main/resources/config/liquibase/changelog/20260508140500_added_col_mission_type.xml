<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Sub-step 2.7 — adds mission_type column to mission.
        VENTE is the default for backwards compatibility (existing rows are sales missions).
    -->
    <changeSet id="20260508140500-1" author="fedi">
        <addColumn tableName="mission">
            <column name="mission_type" type="varchar(50)" defaultValue="VENTE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
